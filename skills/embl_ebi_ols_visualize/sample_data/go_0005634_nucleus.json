{
  "iri": "http://purl.obolibrary.org/obo/GO_0005634",
  "lang": "en",
  "description": [
    "A membrane-bounded organelle of eukaryotic cells in which chromosomes are housed and replicated. In most cells, the nucleus contains all of the cell's chromosomes except the organellar chromosomes, and is the site of RNA synthesis and processing, and of ribosome assembly."
  ],
  "synonyms": [
    "cell nucleus",
    "horsetail nucleus"
  ],
  "annotation": {
    "comment": [
      "Note that nuclear pore complexes and the nuclear lamina are considered part of the nucleus."
    ],
    "has_obo_namespace": [
      "cellular_component"
    ],
